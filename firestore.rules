rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAllowlisted() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/allowlist/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/allowlist/$(request.auth.uid)).data.enabled == true &&
             (!('role' in get(/databases/$(database)/documents/allowlist/$(request.auth.uid)).data) ||
              get(/databases/$(database)/documents/allowlist/$(request.auth.uid)).data.role in ['reader', 'admin']) &&
             (
               !("email" in request.auth.token) || 
               request.auth.token.email == null || 
               get(/databases/$(database)/documents/allowlist/$(request.auth.uid)).data.email == request.auth.token.email
             );
    }

    function isAdmin() {
      return isAllowlisted() &&
             get(/databases/$(database)/documents/allowlist/$(request.auth.uid)).data.role == 'admin';
    }

    function validSettings(data) {
      return data.keys().hasOnly([
               'rssFeeds',
               'excludedGenres',
               'excludedCountries',
               'minMovieRating',
               'minSeriesRating',
               'minImdbVotes',
               'updatedBy'
             ]) &&
             data.rssFeeds is map && data.rssFeeds.keys().size() <= 20 &&
             data.excludedGenres is list && data.excludedGenres.size() <= 100 &&
             data.excludedCountries is list && data.excludedCountries.size() <= 100 &&
             data.minMovieRating is number && data.minMovieRating >= 0 && data.minMovieRating <= 10 &&
             data.minSeriesRating is number && data.minSeriesRating >= 0 && data.minSeriesRating <= 10 &&
             data.minImdbVotes is number && data.minImdbVotes >= 0 && data.minImdbVotes <= 1000000000 &&
             data.updatedBy is string && data.updatedBy.size() > 0 && data.updatedBy.size() <= 128;
    }

    function validManualMapping(data) {
      return data.keys().hasOnly([
               'rawTitle',
               'imdbId',
               'createdAt',
               'parsedTitle',
               'parsedYear',
               'createdBy'
             ]) &&
             data.rawTitle is string && data.rawTitle.size() > 0 && data.rawTitle.size() <= 500 &&
             data.imdbId is string && data.imdbId.matches('^tt[0-9]{7,10}$') &&
             data.createdAt is timestamp &&
             (!('parsedTitle' in data) || data.parsedTitle == null ||
              (data.parsedTitle is string && data.parsedTitle.size() <= 500)) &&
             (!('parsedYear' in data) || data.parsedYear == null ||
              (data.parsedYear is number && data.parsedYear >= 1880 && data.parsedYear <= 2200)) &&
             data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 128;
    }

    match /titles/{titleId} {
      allow read: if isAllowlisted();
      allow create, update: if titleId == 'settings_config' &&
                              isAdmin() &&
                              validSettings(request.resource.data) &&
                              request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
      
      match /occurrences/{occurrenceId} {
        allow read: if isAllowlisted();
        allow write: if false;
      }
    }
    
    match /omdbCache/{cacheId} {
      allow read, write: if false;
    }
    
    match /scanRuns/{runId} {
      allow read, write: if false;
    }

    match /parseLogs/{logId} {
      allow read: if isAllowlisted();
      allow write: if false;
    }

    match /auditProposals/{proposalId} {
      allow read: if isAllowlisted();
      allow write: if false;
    }

    match /manualMappings/{mappingId} {
      allow read: if isAllowlisted();
      allow create: if isAdmin() &&
                    validManualMapping(request.resource.data) &&
                    request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() &&
                    validManualMapping(request.resource.data) &&
                    resource.data.createdBy == request.auth.uid &&
                    request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }
    
    match /allowlist/{userId} {
      // Allowlist writes are server-only. Read is own access check only.
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }
    
    // Owner-scoped user preferences namespace
    match /users/{userId} {
      allow read: if isAllowlisted() && request.auth.uid == userId;
      
      match /userTitles/{titleId} {
        allow read: if isAllowlisted() && request.auth.uid == userId;
        allow create, update: if isAllowlisted() &&
                                request.auth.uid == userId &&
                                request.resource.data.keys().hasOnly(['status', 'updatedAt', 'userId']) &&
                                request.resource.data.status in ['favorite', 'ignored'] &&
                                request.resource.data.userId == userId &&
                                request.resource.data.updatedAt is timestamp;
        allow delete: if isAllowlisted() && request.auth.uid == userId;
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
