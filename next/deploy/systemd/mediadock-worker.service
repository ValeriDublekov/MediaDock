[Unit]
Description=MediaDock RSS ingestion scan
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=mediadock
SupplementaryGroups=docker
WorkingDirectory=/opt/docker/projects/mediadock-next/next
ExecStart=/usr/bin/docker compose --project-name mediadock-next --file /opt/docker/projects/mediadock-next/next/compose.yaml --profile worker run --rm worker --trigger schedule
TimeoutStartSec=infinity
TimeoutStopSec=5min