[Unit]
Description=MediaDock RSS ingestion scan
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=mediadock
SupplementaryGroups=docker
WorkingDirectory=/opt/docker/projects/mediadock-next/next
ExecStart=/usr/local/sbin/mediadock-next-worker
TimeoutStartSec=infinity
TimeoutStopSec=5min